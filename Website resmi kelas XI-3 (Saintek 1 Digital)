<style>
:root{
  --bg:#e7e8ea;
  --surface:#ffffff;
  --surface-alt:#f2f3f5;
  --ink:#212327;
  --ink-2:#6b7078;
  --ink-3:#9a9fa6;
  --line:#d7dade;
  --line-strong:#c2c6cb;
  --accent:#4d5561;
  --accent-2:#7c8593;
  --accent-pale:#e9ebee;
  --accent-glow:#b9c2cf;
  --dark:#1d1f23;
  --gold:#a6935f;
  --radius:16px;
  --radius-sm:10px;
  --shadow:0 8px 24px rgba(30,32,36,.08);
  --shadow-lg:0 20px 48px rgba(30,32,36,.14);
  --font-d:'Space Grotesk',sans-serif;
  --font-b:'Inter',sans-serif;
  --font-m:'IBM Plex Mono',monospace;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-b);line-height:1.55;-webkit-font-smoothing:antialiased;}
img{max-width:100%;display:block;}
a{color:inherit;}
h1,h2,h3,h4{font-family:var(--font-d);margin:0 0 .4em;letter-spacing:-.01em;color:var(--dark);}
p{margin:0 0 1em;}
button{font-family:inherit;cursor:pointer;}
.container{max-width:1180px;margin:0 auto;padding:0 24px;}
.eyebrow{font-family:var(--font-m);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600;}
.section-head{max-width:640px;margin-bottom:36px;}
.section-head p{color:var(--ink-2);}

/* ---------- NAV ---------- */
#topnav{position:sticky;top:0;z-index:100;background:rgba(231,232,234,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
.nav-inner{max-width:1180px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-d);font-weight:700;font-size:1.05rem;}
.chip{width:34px;height:34px;border-radius:9px;background:var(--dark);position:relative;flex-shrink:0;}
.chip::before,.chip::after{content:"";position:absolute;left:8px;right:8px;height:2px;background:var(--accent-glow);}
.chip::before{top:9px;} .chip::after{bottom:9px;}
.chip span{position:absolute;inset:9px;border:1px solid var(--accent-glow);border-radius:3px;}
.navlinks{display:flex;gap:2px;flex-wrap:wrap;}
.navlinks button{background:none;border:none;padding:8px 13px;border-radius:20px;font-size:.86rem;font-weight:600;color:var(--ink-2);transition:.15s;}
.navlinks button:hover{background:var(--accent-pale);color:var(--ink);}
.navlinks button.active{background:var(--dark);color:#fff;}
.navtoggle{display:none;background:var(--dark);color:#fff;border:none;border-radius:8px;padding:8px 12px;font-weight:600;}
@media(max-width:920px){
  .navlinks{position:fixed;top:64px;left:0;right:0;bottom:0;background:var(--bg);flex-direction:column;padding:18px 24px;display:none;overflow:auto;}
  .navlinks.open{display:flex;}
  .navlinks button{text-align:left;font-size:1rem;padding:12px 14px;}
  .navtoggle{display:block;}
}

/* ---------- PAGES ---------- */
.page{display:none;animation:fade .4s ease;}
.page.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

/* ---------- HERO ---------- */
.hero{position:relative;overflow:hidden;padding:76px 0 60px;background:
  radial-gradient(circle at 1px 1px, var(--line-strong) 1px, transparent 0) 0 0/26px 26px,
  var(--bg);}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,var(--bg) 100%);}
.hero-inner{position:relative;z-index:2;display:grid;grid-template-columns:1.3fr .9fr;gap:40px;align-items:center;}
@media(max-width:860px){.hero-inner{grid-template-columns:1fr;}}
.hero h1{font-size:clamp(2.2rem,5vw,3.4rem);line-height:1.04;}
.hero .tag{color:var(--accent);}
.hero-desc{color:var(--ink-2);max-width:480px;font-size:1.02rem;}
.hero-stats{display:flex;gap:28px;margin-top:26px;flex-wrap:wrap;}
.stat b{display:block;font-family:var(--font-d);font-size:1.7rem;color:var(--dark);}
.stat span{font-size:.78rem;color:var(--ink-2);font-family:var(--font-m);text-transform:uppercase;letter-spacing:.08em;}
.hero-chip-art{background:var(--dark);border-radius:20px;padding:26px;position:relative;box-shadow:var(--shadow-lg);}
.hero-chip-art .pins{display:flex;justify-content:space-between;padding:0 14px;}
.hero-chip-art .pins span{width:3px;height:12px;background:var(--accent-glow);display:block;}
.hero-chip-art .core{margin:12px 0;border:1px solid #35383e;border-radius:10px;padding:22px;text-align:center;}
.hero-chip-art .core small{font-family:var(--font-m);color:var(--accent-glow);letter-spacing:.12em;font-size:.68rem;}
.hero-chip-art .core h2{color:#fff;margin:6px 0 0;font-size:1.5rem;}
.hero-chip-art .pins.bottom{transform:scaleY(-1);}

/* ---------- QUOTE ---------- */
.quote-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:34px 38px;box-shadow:var(--shadow);position:relative;margin-top:46px;}
.quote-card .mark{font-family:var(--font-d);font-size:3.4rem;color:var(--accent-glow);line-height:0;position:absolute;top:24px;left:26px;}
.quote-card blockquote{margin:10px 0 14px 34px;font-size:1.12rem;color:var(--dark);font-style:italic;}
.quote-card footer{margin-left:34px;font-family:var(--font-m);font-size:.8rem;color:var(--ink-2);}

/* ---------- GRID / CARD generic ---------- */
.grid{display:grid;gap:18px;}
.g2{grid-template-columns:1fr 1fr;} .g3{grid-template-columns:repeat(3,1fr);} .g4{grid-template-columns:repeat(4,1fr);}
@media(max-width:820px){.g2,.g3,.g4{grid-template-columns:1fr 1fr;}}
@media(max-width:560px){.g2,.g3,.g4{grid-template-columns:1fr;}}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px;}
section.block{padding:64px 0;}
section.block.alt{background:var(--surface-alt);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}

/* ---------- FOTO ANGKATAN mosaic ---------- */
.mosaic{display:grid;grid-template-columns:repeat(9,1fr);gap:6px;}
@media(max-width:760px){.mosaic{grid-template-columns:repeat(6,1fr);}}
@media(max-width:480px){.mosaic{grid-template-columns:repeat(4,1fr);}}
.avatar{aspect-ratio:1;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-family:var(--font-d);font-weight:600;font-size:.82rem;position:relative;overflow:hidden;}
.avatar span.full{position:absolute;bottom:2px;left:4px;right:4px;font-family:var(--font-b);font-size:.5rem;font-weight:600;opacity:0;transition:.2s;text-align:center;line-height:1.1;}
.avatar:hover span.full{opacity:1;}
.avatar:hover{transform:scale(1.06);z-index:2;box-shadow:var(--shadow);}
.avatar{transition:.15s;}

/* ---------- CALENDAR ---------- */
.cal-card{background:var(--dark);border-radius:var(--radius);padding:24px;color:#fff;}
.cal-card h3{color:#fff;}
.cal-item{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid #34373d;}
.cal-item:last-child{border-bottom:none;}
.cal-date{font-family:var(--font-m);background:#2b2e34;border-radius:8px;padding:8px 10px;text-align:center;min-width:52px;font-size:.75rem;line-height:1.2;}
.cal-date b{display:block;font-size:1.1rem;}
.cal-text b{display:block;font-size:.92rem;}
.cal-text span{font-size:.78rem;color:#a7acb4;}

/* ---------- TABS ---------- */
.tabs-bar{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--line);margin-bottom:24px;padding-bottom:0;}
.tab-btn{background:none;border:none;padding:10px 16px;font-weight:600;font-size:.86rem;color:var(--ink-2);border-bottom:2px solid transparent;margin-bottom:-1px;}
.tab-btn.active{color:var(--dark);border-color:var(--dark);}
.tab-panel{display:none;}
.tab-panel.active{display:block;animation:fade .3s ease;}
.sched-table{width:100%;border-collapse:collapse;font-family:var(--font-m);font-size:.88rem;}
.sched-table td{padding:12px 14px;border-bottom:1px solid var(--line);}
.sched-table td.num{color:var(--ink-3);width:34px;}
.sched-table tr:last-child td{border-bottom:none;}

/* ---------- ACCORDION ---------- */
.accordion-item{border:1px solid var(--line);border-radius:var(--radius-sm);margin-bottom:10px;overflow:hidden;background:var(--surface);}
.accordion-head{width:100%;text-align:left;background:none;border:none;padding:15px 18px;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:.92rem;}
.accordion-head .plus{font-family:var(--font-m);color:var(--accent);transition:.2s;}
.accordion-item.open .plus{transform:rotate(45deg);}
.accordion-body{max-height:0;overflow:hidden;transition:max-height .25s ease;}
.accordion-body-in{padding:0 18px 16px;color:var(--ink-2);font-size:.88rem;}

/* ---------- TREE VIEW ---------- */
.tree{font-size:.92rem;}
.tree ul{list-style:none;margin:0;padding-left:26px;border-left:1px dashed var(--line-strong);}
.tree>ul{padding-left:0;border-left:none;}
.tree li{position:relative;margin:6px 0;}
.tnode{display:inline-flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:9px 14px;cursor:pointer;box-shadow:var(--shadow);}
.tnode b{font-family:var(--font-d);font-size:.9rem;}
.tnode small{display:block;color:var(--ink-2);font-family:var(--font-m);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;}
.tnode .car{font-size:.7rem;color:var(--accent);}
.tree .toggle{display:inline-block;width:16px;text-align:center;color:var(--ink-3);}
.tree ul.collapsed{display:none;}

/* ---------- POPOVER (guru) ---------- */
.guru-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px;display:flex;gap:12px;align-items:flex-start;cursor:pointer;position:relative;transition:.15s;}
.guru-card:hover{border-color:var(--accent-2);box-shadow:var(--shadow);}
.guru-ic{width:42px;height:42px;border-radius:10px;background:var(--accent-pale);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;}
.guru-m{font-weight:700;font-size:.9rem;}
.guru-k{color:var(--ink-2);font-size:.78rem;}
.popover{position:absolute;z-index:50;background:var(--dark);color:#fff;border-radius:12px;padding:14px 16px;width:230px;font-size:.82rem;box-shadow:var(--shadow-lg);display:none;}
.popover.show{display:block;animation:fade .15s ease;}
.popover b{display:block;font-size:.92rem;margin-bottom:4px;}
.popover .row{display:flex;justify-content:space-between;color:#b7bcc3;font-family:var(--font-m);font-size:.72rem;margin-top:8px;border-top:1px solid #34373d;padding-top:8px;}
.popover .arrow{position:absolute;bottom:-6px;left:20px;width:12px;height:12px;background:var(--dark);transform:rotate(45deg);}

/* ---------- PAGINATION / murid ---------- */
.murid-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;}
.murid-toolbar input{padding:9px 14px;border:1px solid var(--line-strong);border-radius:20px;font-family:var(--font-b);font-size:.86rem;width:220px;background:var(--surface);}
.murid-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
@media(max-width:760px){.murid-grid{grid-template-columns:repeat(2,1fr);}}
.murid-row{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:11px 14px;display:flex;align-items:center;gap:10px;font-size:.85rem;}
.murid-row .no{font-family:var(--font-m);color:var(--ink-3);font-size:.72rem;width:22px;}
.murid-row .in{width:30px;height:30px;border-radius:50%;background:var(--accent-pale);color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.72rem;flex-shrink:0;}
.pagination{display:flex;gap:6px;justify-content:center;margin-top:22px;flex-wrap:wrap;}
.pagination button{width:34px;height:34px;border-radius:50%;border:1px solid var(--line-strong);background:var(--surface);font-size:.82rem;font-weight:600;color:var(--ink-2);}
.pagination button.active{background:var(--dark);color:#fff;border-color:var(--dark);}
.pagination button.nav{width:auto;padding:0 12px;border-radius:17px;}

/* ---------- CAROUSEL ---------- */
.carousel{position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);}
.car-track{display:flex;transition:transform .45s cubic-bezier(.65,0,.35,1);}
.car-slide{min-width:100%;aspect-ratio:16/7;display:flex;align-items:flex-end;padding:30px;position:relative;}
.car-slide h4{color:#fff;font-size:1.3rem;margin:0;}
.car-slide p{color:#e7e9ec;margin:0;font-size:.85rem;}
.car-slide::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.55));}
.car-slide .txt{position:relative;z-index:2;}
.car-btn{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.85);border:none;font-size:1rem;color:var(--dark);z-index:3;}
.car-btn.prev{left:14px;} .car-btn.next{right:14px;}
.car-dots{position:absolute;bottom:12px;right:16px;z-index:3;display:flex;gap:6px;}
.car-dots span{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;}
.car-dots span.active{background:#fff;width:18px;border-radius:4px;}

@media(max-width:560px){.g2{grid-template-columns:1fr;}}

/* ---------- MADING / PRESTASI cards ---------- */
.doc-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;}
.doc-thumb{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:2.2rem;color:#fff;}
.doc-body{padding:16px;}
.doc-body h4{font-size:.98rem;margin-bottom:4px;}
.doc-body span{font-family:var(--font-m);font-size:.7rem;color:var(--ink-2);text-transform:uppercase;letter-spacing:.06em;}

/* ---------- RATING ---------- */
.rating{display:flex;gap:3px;}
.rating i{font-size:1.15rem;color:var(--line-strong);cursor:pointer;transition:.1s;font-style:normal;}
.rating i.on{color:var(--gold);}
.rating.readonly i{cursor:default;}

/* ---------- FORMS ---------- */
label{display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:var(--ink);}
input[type=text],input[type=email],input[type=tel],textarea,select{width:100%;padding:11px 14px;border:1px solid var(--line-strong);border-radius:10px;font-family:var(--font-b);font-size:.9rem;background:var(--surface);margin-bottom:16px;}
textarea{resize:vertical;min-height:100px;}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--dark);color:#fff;border:none;padding:12px 22px;border-radius:24px;font-weight:600;font-size:.88rem;}
.btn.ghost{background:none;border:1px solid var(--line-strong);color:var(--ink);}
.btn.wa{background:#3a5a40;}

/* ---------- FOOTER ---------- */
footer{background:var(--dark);color:#c6c9ce;padding:44px 0 26px;font-size:.86rem;}
footer h4{color:#fff;font-size:.95rem;}
footer .fgrid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px;}
@media(max-width:700px){footer .fgrid{grid-template-columns:1fr;}}
footer .bottom{border-top:1px solid #34373d;margin-top:30px;padding-top:18px;font-size:.76rem;color:#7d828a;font-family:var(--font-m);}
.badge-soft{display:inline-block;background:var(--accent-pale);color:var(--accent);font-family:var(--font-m);font-size:.68rem;padding:4px 10px;border-radius:20px;letter-spacing:.05em;text-transform:uppercase;margin-bottom:12px;}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(120%);background:var(--dark);color:#fff;padding:13px 22px;border-radius:30px;font-size:.86rem;box-shadow:var(--shadow-lg);z-index:999;transition:.3s;}
.toast.show{transform:translateX(-50%) translateY(0);}
</style>
</head>
