    });
  });
  document.getElementById('curhatSubmit').addEventListener('click',()=>{
    const val=document.getElementById('curhatText').value.trim();
    if(!val){toast('Tulis pesanmu dahulu ya.');return;}
    document.getElementById('curhatText').value='';
    toast('Pesan anonimmu terkirim. Terima kasih sudah bersuara 💙');
  });
}

function renderKontak(){
  document.getElementById('kontakSubmit').addEventListener('click',()=>toast('Pesan terkirim, kelas XI-3 akan segera merespons 👋'));
}

const RENDERERS={beranda:renderBeranda,profil:renderProfil,akademik:renderAkademik,galeri:renderGaleri,mading:renderMading,prestasi:renderPrestasi,curhat:renderCurhat,kontak:renderKontak};

/* ================= NAV / ROUTER ================= */
function showPage(name){
  document.getElementById('app').innerHTML=PAGES[name]();
  RENDERERS[name]();
  document.querySelectorAll('.navlinks button').forEach(b=>b.classList.toggle('active',b.dataset.p===name));
  document.getElementById('navLinks').classList.remove('open');
  window.scrollTo({top:0,behavior:'smooth'});
}
document.querySelectorAll('.navlinks button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.p)));
document.getElementById('navToggle').addEventListener('click',()=>document.getElementById('navLinks').classList.toggle('open'));

showPage('beranda');
</script>
</body>
