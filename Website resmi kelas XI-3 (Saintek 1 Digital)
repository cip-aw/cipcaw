          <ul id="t4">
            <li><div class="tnode"><span class="toggle">•</span> <div><b>Thahira Sabita Salman S.</b><small>Wakil Bendahara</small></div></div></li>
          </ul>
        </li>
      </ul>
    </li>
  </ul>`;
  document.querySelectorAll('.tnode[data-t]').forEach(el=>{
    el.addEventListener('click',()=>{
      const id=el.getAttribute('data-t');
      const ul=document.getElementById('t'+id);
      ul.classList.toggle('collapsed');
      el.querySelector('.toggle').textContent=ul.classList.contains('collapsed')?'▸':'▾';
    });
  });

  let page=1,per=9,filtered=[...MURID];
  function draw(){
    const start=(page-1)*per;
    const items=filtered.slice(start,start+per);
    document.getElementById('muridGrid').innerHTML=items.map(n=>{
      const idx=MURID.indexOf(n)+1;
      return `<div class="murid-row"><span class="no">${String(idx).padStart(2,'0')}</span><div class="in">${initials(n)}</div>${n}</div>`;
    }).join('') || '<p style="color:var(--ink-2)">Nama tidak ditemukan.</p>';
    const totalPages=Math.max(1,Math.ceil(filtered.length/per));
    let html=`<button class="nav" ${page===1?'disabled':''} id="prevP">‹ Prev</button>`;
    for(let i=1;i<=totalPages;i++) html+=`<button class="${i===page?'active':''}" data-pg="${i}">${i}</button>`;
    html+=`<button class="nav" ${page===totalPages?'disabled':''} id="nextP">Next ›</button>`;
    document.getElementById('muridPage').innerHTML=html;
    document.querySelectorAll('#muridPage button[data-pg]').forEach(b=>b.addEventListener('click',()=>{page=+b.dataset.pg;draw();}));
    const pv=document.getElementById('prevP'),nx=document.getElementById('nextP');
    if(pv)pv.addEventListener('click',()=>{if(page>1){page--;draw();}});
    if(nx)nx.addEventListener('click',()=>{if(page<totalPages){page++;draw();}});
  }
  draw();
  document.getElementById('muridSearch').addEventListener('input',e=>{
    filtered=MURID.filter(n=>n.toLowerCase().includes(e.target.value.toLowerCase()));
    page=1;draw();
  });
}

