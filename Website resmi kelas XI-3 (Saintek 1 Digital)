function renderGaleri(){
  const slides=MADING;
  let idx=0;
  const el=document.getElementById('carousel');
  el.innerHTML=`
    <div class="car-track">${slides.map((s,i)=>`<div class="car-slide" style="background:${AVCOLORS[i%AVCOLORS.length]}"><div class="txt"><h4>${s.ic} ${s.t}</h4><p>${s.tag} · ${s.d}</p></div></div>`).join('')}</div>
    <button class="car-btn prev">‹</button><button class="car-btn next">›</button>
    <div class="car-dots">${slides.map((_,i)=>`<span data-i="${i}" class="${i===0?'active':''}"></span>`).join('')}</div>
  `;
  const track=el.querySelector('.car-track');
  function go(n){idx=(n+slides.length)%slides.length;track.style.transform=`translateX(-${idx*100}%)`;el.querySelectorAll('.car-dots span').forEach((d,i)=>d.classList.toggle('active',i===idx));}
  el.querySelector('.prev').addEventListener('click',()=>go(idx-1));
  el.querySelector('.next').addEventListener('click',()=>go(idx+1));
  el.querySelectorAll('.car-dots span').forEach(d=>d.addEventListener('click',()=>go(+d.dataset.i)));
  clearInterval(window._carInt);
  window._carInt=setInterval(()=>go(idx+1),4500);
}

